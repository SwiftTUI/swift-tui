# Windows checkouts must smudge to LF (Windows plan, Stage 6 item 3): tests
# byte-compare rendered output against committed fixtures and parse repo
# files by line, so a core.autocrlf=true checkout breaks them with stray
# carriage returns. `text=auto` keeps binary detection; eol=lf pins the
# working-tree line ending on every platform.
* text=auto eol=lf

# Preserve upstream font notices byte-for-byte: the asset manifest hashes them.
Platforms/WebHost/Sources/SwiftTUIWebHost/Resources/browser/assets/swifttui-fonts/**/LICENSE.md -text
