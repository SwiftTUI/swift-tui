{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swifttui.dev/contracts/1/schemas/cli-frame.schema.json",
  "type": "object",
  "properties": {
    "type": {
      "const": "frame"
    },
    "size": {
      "type": "object",
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 0
        },
        "height": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "width",
        "height"
      ],
      "additionalProperties": true
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "accessibilityNodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "parentId": {
            "type": [
              "string",
              "null"
            ]
          },
          "role": {
            "type": "string"
          },
          "label": {
            "type": [
              "string",
              "null"
            ]
          },
          "hint": {
            "type": [
              "string",
              "null"
            ]
          },
          "rect": {
            "type": "object",
            "properties": {
              "x": {
                "type": "integer"
              },
              "y": {
                "type": "integer"
              },
              "width": {
                "type": "integer",
                "minimum": 0
              },
              "height": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "x",
              "y",
              "width",
              "height"
            ],
            "additionalProperties": true
          },
          "hidden": {
            "type": "boolean"
          },
          "focused": {
            "type": "boolean"
          },
          "liveRegion": {
            "type": [
              "string",
              "null"
            ]
          },
          "cursorAnchor": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "integer"
                  },
                  "y": {
                    "type": "integer"
                  }
                },
                "required": [
                  "x",
                  "y"
                ],
                "additionalProperties": true
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "parentId",
          "role",
          "label",
          "hint",
          "rect",
          "hidden",
          "focused",
          "liveRegion",
          "cursorAnchor"
        ],
        "additionalProperties": true
      }
    },
    "accessibilityAnnouncements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "politeness": {
            "$ref": "host.schema.json#/$defs/politeness"
          }
        },
        "required": [
          "message",
          "politeness"
        ],
        "additionalProperties": true
      }
    },
    "accessibilityWarnings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "message"
        ],
        "additionalProperties": true
      }
    }
  },
  "required": [
    "type",
    "size",
    "rows",
    "accessibilityNodes",
    "accessibilityAnnouncements",
    "accessibilityWarnings"
  ],
  "additionalProperties": true
}
